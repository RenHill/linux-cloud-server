#!/bin/bash

# health_check.sh - Server Health Check Script (Extended)
# A cloud engineer's automated health monitoring tool

set -euo pipefail

# Configuration
LOG_DIR="$HOME/server-admin/logs"
LOG_FILE="$LOG_DIR/health_report.log"
DISK_THRESHOLD=80
MEM_THRESHOLD=90
WARNING_COUNT=0

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Timestamp
TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

# Start report
echo "========================================" | tee -a "$LOG_FILE"
echo "  Health Check Report" | tee -a "$LOG_FILE"
echo "  $TIMESTAMP" | tee -a "$LOG_FILE"
echo "========================================" | tee -a "$LOG_FILE"

# 1. Disk Usage Check
echo "" | tee -a "$LOG_FILE"
echo "[Disk Usage]" | tee -a "$LOG_FILE"
DISK_USAGE=$(df / | tail -1 | awk '{print $5}' | sed 's/%//')
df -h / | tail -1 | awk '{print "  Root: " $5 " used (" $3 " of " $2 ")"}' | tee -a "$LOG_FILE"

if [ "$DISK_USAGE" -gt "$DISK_THRESHOLD" ]; then
    echo "  WARNING: Disk usage exceeds ${DISK_THRESHOLD}%!" | tee -a "$LOG_FILE"
    WARNING_COUNT=$((WARNING_COUNT + 1))
else
    echo "  Status: Healthy" | tee -a "$LOG_FILE"
fi

# 2. Memory Usage Check
echo "" | tee -a "$LOG_FILE"
echo "[Memory Usage]" | tee -a "$LOG_FILE"
MEM_USAGE=$(free | grep Mem | awk '{printf "%.0f", $3/$2*100}')
free -m | grep Mem | awk '{printf "  Used: %sMB / %sMB (%.1f%%)\n", $3, $2, $3/$2*100}' | tee -a "$LOG_FILE"

if [ "$MEM_USAGE" -gt "$MEM_THRESHOLD" ]; then
    echo "  WARNING: Memory usage exceeds ${MEM_THRESHOLD}%!" | tee -a "$LOG_FILE"
    WARNING_COUNT=$((WARNING_COUNT + 1))
else
    echo "  Status: Healthy" | tee -a "$LOG_FILE"
fi

# 3. Top CPU Processes
echo "" | tee -a "$LOG_FILE"
echo "[Top 5 Processes by CPU]" | tee -a "$LOG_FILE"
ps aux --sort=-%cpu | head -6 | tail -5 | awk '{printf "  %-12s %5s%% CPU  %s\n", $1, $3, $11}' | tee -a "$LOG_FILE"

# 4. Service Status Check
echo "" | tee -a "$LOG_FILE"
echo "[Service Status]" | tee -a "$LOG_FILE"
SERVICES=("cron" "ssh" "networkd-dispatcher")
for SERVICE in "${SERVICES[@]}"; do
    if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        echo "  [OK] $SERVICE is running" | tee -a "$LOG_FILE"
    else
        echo "  [FAIL] $SERVICE is NOT running" | tee -a "$LOG_FILE"
        WARNING_COUNT=$((WARNING_COUNT + 1))
    fi
done

# 5. Recent Error Check
echo "" | tee -a "$LOG_FILE"
echo "[Recent Errors (last 10 minutes)]" | tee -a "$LOG_FILE"
ERROR_COUNT=$(journalctl --since "10 minutes ago" -p err --no-pager 2>/dev/null | grep -c "" || true)
echo "  Found $ERROR_COUNT error-level log entries" | tee -a "$LOG_FILE"

if [ "$ERROR_COUNT" -gt 0 ]; then
    WARNING_COUNT=$((WARNING_COUNT + 1))
fi

# Summary
echo "" | tee -a "$LOG_FILE"
echo "----------------------------------------" | tee -a "$LOG_FILE"
if [ "$WARNING_COUNT" -gt 0 ]; then
    echo "  RESULT: $WARNING_COUNT warning(s) detected!" | tee -a "$LOG_FILE"
else
    echo "  RESULT: All systems healthy" | tee -a "$LOG_FILE"
fi
echo "  Report saved to: $LOG_FILE" | tee -a "$LOG_FILE"
echo "========================================" | tee -a "$LOG_FILE"
